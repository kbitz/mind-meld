#!/bin/sh
# bin/bootstrap — Ready a macOS or Arch-based Linux machine for Mind Meld (mm)
# and Syncthing.
#
# POSIX /bin/sh (not bash): macOS ships bash 3.2 and Ubuntu CI runs /bin/sh as
# dash. See bin/check for the same portability rule.
#
# README downloads this into a variable and runs it with `sh -c` only when
# the download succeeds. All the work also happens in main(), called on the
# last line, so a copy cut off part-way defines at most some functions and
# runs nothing.

set -eu

MM_INSTALL_SPEC="git+https://github.com/kbitz/mind-meld.git@latest"
MM_RELEASE="1.12.43"
SYNCTHING_PLISTS="sh.brew.syncthing.plist homebrew.mxcl.syncthing.plist"
HOMEBREW_INSTALL_CMD='/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'

say() {
  printf 'bootstrap: %s\n' "$*"
}

die() {
  printf 'bootstrap: %s. Run: %s\n' "$1" "$2" >&2
  exit 1
}

read_python_minor_version() {
  py_ver=""
  if ! command -v python3 >/dev/null 2>&1; then
    return 1
  fi
  py_out=$(python3 --version 2>&1 || true)
  py_ver=$(printf '%s\n' "$py_out" | sed -n 's/^Python \([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | sed -n '1p')
  [ -n "$py_ver" ]
}

python_version_ok() {
  read_python_minor_version || return 1
  py_major=${py_ver%%.*}
  py_minor=${py_ver#*.}
  [ "$py_major" -gt 3 ] || { [ "$py_major" -eq 3 ] && [ "$py_minor" -ge 11 ]; }
}

read_syncthing_version() {
  st_ver=""
  if ! command -v syncthing >/dev/null 2>&1; then
    return 1
  fi
  st_out=$(syncthing --version 2>&1 || true)
  st_ver=$(printf '%s\n' "$st_out" | sed -n 's/^syncthing v\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | sed -n '1p')
  [ -n "$st_ver" ]
}

syncthing_version_ok() {
  read_syncthing_version || return 1
  st_major=${st_ver%%.*}
  st_rest=${st_ver#*.}
  st_minor=${st_rest%%.*}
  [ "$st_major" -gt 2 ] || { [ "$st_major" -eq 2 ] && [ "$st_minor" -ge 1 ]; }
}

listed_mm_version() {
  mm_ver=$(printf '%s\n' "$1" | sed -n 's/^mind-meld \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | sed -n '1p')
  [ -n "$mm_ver" ]
}

version_older() {
  va_major=${1%%.*}
  va_rest=${1#*.}
  va_minor=${va_rest%%.*}
  va_patch=${va_rest#*.}
  vb_major=${2%%.*}
  vb_rest=${2#*.}
  vb_minor=${vb_rest%%.*}
  vb_patch=${vb_rest#*.}
  [ "$va_major" -lt "$vb_major" ] \
    || { [ "$va_major" -eq "$vb_major" ] && [ "$va_minor" -lt "$vb_minor" ]; } \
    || { [ "$va_major" -eq "$vb_major" ] && [ "$va_minor" -eq "$vb_minor" ] && [ "$va_patch" -lt "$vb_patch" ]; }
}

unsupported_os() {
  die "$1 is not supported; bootstrap supports macOS and Arch-based Linux. Install Python 3.11+, pipx and Syncthing 2.1+ yourself" "pipx install $MM_INSTALL_SPEC"
}

check_pipx_link() {
  pipx_mm="$venvs/mind-meld/bin/mm"
  if ! [ "$bin/mm" -ef "$pipx_mm" ] 2>/dev/null; then
    if [ -e "$bin/mm" ] || [ -L "$bin/mm" ]; then
      die "$bin/mm is not pipx's mind-meld copy; another install put it there" "pipx install --force $MM_INSTALL_SPEC"
    fi
    die "pipx's link $bin/mm is missing" "pipx install --force $MM_INSTALL_SPEC"
  fi
}

read_syncthing_login() {
  st_login="unknown"
  if [ "$platform" = "macos" ]; then
    st_login="no"
    for plist_name in $SYNCTHING_PLISTS; do
      if [ -e "$HOME/Library/LaunchAgents/$plist_name" ]; then
        st_login="yes"
        return 0
      elif [ -L "$HOME/Library/LaunchAgents/$plist_name" ]; then
        st_login="unknown"
      fi
    done
  else
    st_enabled=$(systemctl --user is-enabled syncthing.service 2>/dev/null || true)
    case "$st_enabled" in
      enabled)
        st_login="yes"
        ;;
      disabled)
        st_login="no"
        ;;
      *)
        st_login="unknown"
        ;;
    esac
  fi
}

ensure_syncthing_at_login() {
  st_check_py='from mind_meld import syncthing; c = syncthing.classify_config(sanitize=str); print(c.state, c.reach)'
  st_check=$("$venvs/mind-meld/bin/python" -I -c "$st_check_py" 2>/dev/null || true)
  st_state=""
  st_reach=""
  if [ -n "$st_check" ]; then
    st_state=${st_check%% *}
    if [ "$st_state" != "$st_check" ]; then
      st_reach=${st_check#* }
      st_reach=${st_reach%% *}
    fi
  fi
  read_syncthing_login
  case "$st_login" in
    yes)
      login_clause=" It already starts at login."
      ;;
    no)
      login_clause=" It does not start at login; to make it, run: $start_syncthing_cmd"
      ;;
    *)
      login_clause=" To make it start at login, run: $start_syncthing_cmd"
      ;;
  esac
  if [ "$st_state" = "pre-existing" ]; then
    say "Syncthing already has its own configuration, so this script changes nothing in it (see README \"Configuring Syncthing yourself\").$login_clause"
    return 0
  fi
  if [ "$st_state" != "default" ] && [ "$st_state" != "no-config" ]; then
    say "could not check Syncthing's configuration, so this script changed nothing in it; mm diag shows why.$login_clause"
    return 0
  fi
  running=0
  case "$st_reach" in
    ok|unauthorized|error)
      running=1
      ;;
  esac
  if [ "$running" -eq 0 ] && command -v pgrep >/dev/null 2>&1; then
    if pgrep -x -u "$(id -u)" syncthing >/dev/null 2>&1; then
      running=1
    fi
  fi
  if [ "$st_login" = "yes" ] && [ "$running" -eq 1 ]; then
    say "Syncthing is running and already starts at login."
  elif [ "$st_login" = "yes" ]; then
    say "Syncthing already starts at login but is not running; to start it now, run: $start_now_cmd"
  elif [ "$running" -eq 1 ]; then
    if [ "$platform" = "macos" ]; then
      if [ "$st_login" = "unknown" ]; then
        die "Syncthing's login item is a broken link; quit the running Syncthing first" "brew services start syncthing"
      fi
      keg=$(brew --prefix syncthing 2>/dev/null || true)
      keg_plist=""
      for plist_name in $SYNCTHING_PLISTS; do
        if [ -n "$keg" ] && [ -f "$keg/$plist_name" ]; then
          keg_plist="$keg/$plist_name"
          break
        fi
      done
      if [ -z "$keg_plist" ]; then
        die "Homebrew's Syncthing login item was not found; quit the running Syncthing first" "brew services start syncthing"
      fi
      launch_agents="$HOME/Library/LaunchAgents"
      dest_plist="$launch_agents/$plist_name"
      tmp_plist=""
      if ! { mkdir -p "$launch_agents" \
        && tmp_plist=$(mktemp "$launch_agents/.syncthing.XXXXXX") \
        && cp "$keg_plist" "$tmp_plist" \
        && chmod 0644 "$tmp_plist" \
        && mv -f "$tmp_plist" "$dest_plist"; }; then
        if [ -n "$tmp_plist" ]; then
          rm -f "$tmp_plist" 2>/dev/null || true
        fi
        die "could not register Syncthing to start at login; quit the running Syncthing first" "brew services start syncthing"
      fi
      say "Syncthing is already running; set it to start at login from your next login (~/Library/LaunchAgents/$plist_name)."
    else
      # shellcheck disable=SC2086
      if ! $enable_syncthing_cmd; then
        die "$enable_syncthing_cmd failed" "$enable_syncthing_cmd"
      fi
      say "Syncthing is already running; set it to start at login ($enable_syncthing_cmd)."
    fi
  else
    # shellcheck disable=SC2086
    if ! $start_syncthing_cmd; then
      die "$start_syncthing_cmd failed" "$start_syncthing_cmd"
    fi
    say "started Syncthing and set it to start at login ($start_syncthing_cmd)."
  fi
}

main() {
  os_name=$(uname -s)
  platform=""
  case "$os_name" in
    Darwin)
      platform="macos"
      ;;
    Linux)
      os_release="${MM_BOOTSTRAP_OS_RELEASE:-/etc/os-release}"
      os_id=""
      os_id_like=""
      if [ -r "$os_release" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
          case "$line" in
            ID=*)
              val=${line#ID=}
              val=${val#\"}; val=${val%\"}
              val=${val#\'}; val=${val%\'}
              os_id=$val
              ;;
            ID_LIKE=*)
              val=${line#ID_LIKE=}
              val=${val#\"}; val=${val%\"}
              val=${val#\'}; val=${val%\'}
              os_id_like=$val
              ;;
          esac
        done <"$os_release"
      fi
      is_arch=0
      if [ "$os_id" = "arch" ]; then
        is_arch=1
      else
        case " $os_id_like " in
          *" arch "*)
            is_arch=1
            ;;
        esac
      fi
      if [ "$is_arch" -ne 1 ]; then
        unsupported_os "${os_id:-Linux}"
      fi
      platform="arch"
      ;;
    *)
      unsupported_os "$os_name"
      ;;
  esac

  changed=0
  installed_list=""
  upgraded=""
  missing=""

  if [ "$platform" = "macos" ]; then
    if ! command -v brew >/dev/null 2>&1; then
      die "Homebrew is not installed or not on PATH; install it (its installer ends by showing how to put brew on PATH), then rerun this script" "$HOMEBREW_INSTALL_CMD"
    fi
    if ! python_version_ok; then
      missing="python"
    fi
    if ! command -v pipx >/dev/null 2>&1; then
      missing="${missing:+$missing }pipx"
    fi
    if ! command -v syncthing >/dev/null 2>&1; then
      missing="${missing:+$missing }syncthing"
    fi
    if [ -n "$missing" ]; then
      install_cmd="brew install $missing"
      say "installing missing Homebrew packages: $missing"
      # shellcheck disable=SC2086
      if ! brew install $missing; then
        die "$install_cmd failed" "$install_cmd"
      fi
      changed=1
      installed_list="$missing"
      hash -r 2>/dev/null || true
    fi
    py_fix='eval "$(brew shellenv)"'
    st_fix="brew upgrade syncthing"
    pipx_fix="brew reinstall pipx"
    start_syncthing_cmd="brew services start syncthing"
    start_now_cmd="brew services start syncthing"
  else
    if [ "$(id -u)" = "0" ]; then
      SUDO=""
      sudo_prefix=""
    else
      SUDO="sudo"
      sudo_prefix="sudo "
    fi
    if ! command -v pacman >/dev/null 2>&1; then
      die "pacman was not found on PATH" "${sudo_prefix}pacman -S --needed python python-pipx syncthing git"
    fi
    if ! command -v python3 >/dev/null 2>&1; then
      missing="python"
    fi
    if ! command -v pipx >/dev/null 2>&1; then
      missing="${missing:+$missing }python-pipx"
    fi
    if ! command -v syncthing >/dev/null 2>&1; then
      missing="${missing:+$missing }syncthing"
    fi
    if ! command -v git >/dev/null 2>&1; then
      missing="${missing:+$missing }git"
    fi
    if [ -n "$missing" ]; then
      install_cmd="${sudo_prefix}pacman -S --needed $missing"
      say "installing missing Arch packages: $missing"
      if [ -n "$SUDO" ]; then
        # shellcheck disable=SC2086
        if ! "$SUDO" pacman -S --needed $missing; then
          die "$install_cmd failed" "$install_cmd"
        fi
      else
        # shellcheck disable=SC2086
        if ! pacman -S --needed $missing; then
          die "$install_cmd failed" "$install_cmd"
        fi
      fi
      changed=1
      installed_list="$missing"
      hash -r 2>/dev/null || true
    fi
    py_fix="${sudo_prefix}pacman -Syu"
    st_fix="${sudo_prefix}pacman -Syu"
    pipx_fix="${sudo_prefix}pacman -S python-pipx"
    start_syncthing_cmd="systemctl --user enable --now syncthing.service"
    enable_syncthing_cmd="systemctl --user enable syncthing.service"
    start_now_cmd="systemctl --user start syncthing.service"
  fi

  if ! read_python_minor_version; then
    die "could not read the python3 version (need Python 3.11 or newer)" "$py_fix"
  fi
  if ! python_version_ok; then
    die "python3 is $py_ver, but Mind Meld requires Python 3.11 or newer" "$py_fix"
  fi

  if ! read_syncthing_version; then
    die "could not read the syncthing version (need Syncthing 2.1 or newer)" "$st_fix"
  fi
  if ! syncthing_version_ok; then
    die "syncthing is $st_ver, but Mind Meld requires Syncthing 2.1 or newer" "$st_fix"
  fi

  bin=$(pipx environment --value PIPX_BIN_DIR 2>/dev/null || true)
  venvs=$(pipx environment --value PIPX_LOCAL_VENVS 2>/dev/null || true)
  if [ -z "$bin" ] || [ -z "$venvs" ]; then
    die "pipx could not report PIPX_BIN_DIR and PIPX_LOCAL_VENVS" "$pipx_fix"
  fi

  nl='
'
  mm_installed=0
  # `pipx list` exits 1 when any venv has a problem but still lists the rest,
  # so read its output whatever the exit status.
  pipx_list=$(pipx list --short 2>/dev/null || true)
  case "${nl}${pipx_list}" in
    *"${nl}mind-meld "*)
      mm_installed=1
      ;;
  esac

  if [ "$mm_installed" -eq 0 ]; then
    say "installing mm with pipx"
    if ! GIT_TERMINAL_PROMPT=0 pipx install "$MM_INSTALL_SPEC"; then
      die "pipx could not install mm" "pipx install $MM_INSTALL_SPEC"
    fi
    changed=1
    installed_list="${installed_list:+$installed_list }mm"
    hash -r 2>/dev/null || true
  elif listed_mm_version "$pipx_list" && version_older "$mm_ver" "$MM_RELEASE"; then
    old=$mm_ver
    upgrade_probe_py='from mind_meld import upgrade; print(" ".join(upgrade.update_argv("pipx", upgrade.detect_install())[1:]))'
    upgrade_args=$("$venvs/mind-meld/bin/python" -I -c "$upgrade_probe_py" 2>/dev/null || true)
    if [ "$upgrade_args" = "upgrade mind-meld" ]; then
      upgrade_cmd="pipx upgrade mind-meld"
      say "upgrading mm $old with pipx"
      if ! GIT_TERMINAL_PROMPT=0 pipx upgrade mind-meld; then
        die "$upgrade_cmd failed, so mm stays at $old" "$upgrade_cmd"
      fi
    elif [ "$upgrade_args" = "install --force $MM_INSTALL_SPEC" ]; then
      upgrade_cmd="pipx install --force $MM_INSTALL_SPEC"
      # A forced reinstall replaces exposed apps, so check ownership first.
      check_pipx_link
      say "upgrading mm $old with pipx"
      if ! GIT_TERMINAL_PROMPT=0 pipx install --force "$MM_INSTALL_SPEC"; then
        die "$upgrade_cmd failed; mm may need reinstalling" "$upgrade_cmd"
      fi
    else
      die "could not tell how mm $old was installed, so it was not upgraded to $MM_RELEASE" "pipx install --force $MM_INSTALL_SPEC"
    fi
    hash -r 2>/dev/null || true
    pipx_list=$(pipx list --short 2>/dev/null || true)
    new=""
    if listed_mm_version "$pipx_list"; then
      new=$mm_ver
    fi
    if [ -z "$new" ] || version_older "$new" "$MM_RELEASE"; then
      die "pipx reported success but mm is still ${new:-missing}, older than this script's $MM_RELEASE" "pipx install --force $MM_INSTALL_SPEC"
    fi
    changed=1
    upgraded="upgraded mm $old to $new"
  fi

  # pipx's copy is its mind-meld venv's entry point, linked at $bin/mm. pipx
  # leaves a file another installer already put there in place, and never
  # relinks a missing link on a plain install, so check the link itself first.
  check_pipx_link
  found=$(command -v mm 2>/dev/null || true)
  if [ -z "$found" ]; then
    die "mm is installed in $bin, which is not on PATH; open a new terminal and rerun this script afterwards" "pipx ensurepath"
  fi
  if ! [ "$found" -ef "$pipx_mm" ] 2>/dev/null; then
    die "$found shadows pipx's $bin/mm; open a new terminal and rerun this script afterwards" "pipx ensurepath --prepend --force"
  fi

  if [ "$changed" -eq 1 ]; then
    summary=""
    if [ -n "$installed_list" ]; then
      summary="installed $installed_list"
    fi
    if [ -n "$upgraded" ]; then
      summary="${summary:+$summary, }$upgraded"
    fi
    say "$summary; Python $py_ver, Syncthing $st_ver and mm are ready."
  else
    say "nothing to change: Python $py_ver, pipx, Syncthing $st_ver and mm are already installed."
  fi
  ensure_syncthing_at_login
  say "Next: run mm init --new-fleet on your fleet's first machine, or mm init to join this machine to the fleet. README Quick Start has the details."
}

main "$@"
